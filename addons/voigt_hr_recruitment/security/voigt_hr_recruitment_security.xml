<odoo>
    <record id="group_voigt_recruitment_manager" model="res.groups">
        <field name="name">Voigt Recruitment Manager</field>
        <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_manager'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>
    <record id="group_voigt_occupational_health" model="res.groups">
        <field name="name">Voigt Occupational Health</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_voigt_psychologist" model="res.groups">
        <field name="name">Voigt Organizational Psychologist</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
